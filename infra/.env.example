# Copy to infra/.env and fill in, or run: scripts/gen-dev-secrets.sh
# Compose refuses to start if any of these are unset — that is deliberate.
# There are no default values anywhere in the tree.

NEXTAUTH_SECRET=      # session/JWT signing (32-byte hex)
PII_ENCRYPTION_KEY=   # PII field encryption (32-byte hex)
JWT_SECRET=           # marketing-site admin console (32-byte hex)
ENCRYPTION_KEY=       # marketing-site field encryption (32-byte hex)
SSO_SECRET=           # platform wizard (32-byte hex)

# Public cross-platform origins used by hosted identity navigation.
PLATFORM_WIZARD_URL=http://localhost:4000
TENANT_APP_URL=http://localhost:4003
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=UniERP
WEBAUTHN_ORIGINS=http://localhost:3005

# Hosted UniERP login/registration providers. Buttons appear only when both
# credentials are present and the matching ENABLED flag is true.
# Local callback URLs to register at each provider:
#   http://localhost:3005/api/v1/auth/oauth/google/callback
#   http://localhost:3005/api/v1/auth/oauth/microsoft/callback
#   http://localhost:3005/api/v1/auth/oauth/github/callback
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Named bootstrap identities. Authorization still comes from provider/tenant
# memberships and concrete permissions; runtime code never compares email.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=kannan19302@gmail.com
# Optional one-time bcrypt/Argon2 password hash for a new provider-realm user.
# Leave blank when the approved account already has a password credential. The
# seed never installs or restores a shared default password.
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD_HASH=
BOOTSTRAP_TENANT_ADMIN_EMAIL=kannan19302@gmail.com

# Transactional auth email. `auto` tries Resend, then Brevo, then SMTP. A job
# with no configured provider fails visibly and is retried instead of being
# marked complete without delivery.
EMAIL_PROVIDER=auto
EMAIL_FROM=UniERP <noreply@your-verified-domain.example>
RESEND_API_KEY=
BREVO_API_KEY=
# Blank values use the compose-local Mailpit inbox at http://localhost:8025.
# Set a real provider host/port only outside the local compose stack.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Versioned registration legal documents. Production IdP startup rejects
# localhost URLs and draft/development version identifiers.
TERMS_OF_SERVICE_URL=https://www.your-domain.example/terms
TERMS_OF_SERVICE_VERSION=2026-07
TERMS_OF_SERVICE_EFFECTIVE_DATE=2026-07-01
PRIVACY_POLICY_URL=https://www.your-domain.example/privacy
PRIVACY_POLICY_VERSION=2026-07
PRIVACY_POLICY_EFFECTIVE_DATE=2026-07-01
