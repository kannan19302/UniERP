{
  "$schema": "https://unierp.io/schemas/programme-claims.json",
  "description": "Authoritative repository claims and accountable platform assignments across all 31 active estate repositories.",
  "repos": {
    "api": { "owner": "PLT-BIZ", "role": "Business services, domain logic, and financial ledgers" },
    "auth": { "owner": "PLT-IDENTITY", "role": "Authentication and authorization client primitives" },
    "blockchain": { "owner": "PLT-BIZ", "role": "Distributed ledger and smart contracts" },
    "config": { "owner": "PLT-OPS", "role": "Platform configuration and governance" },
    "data": { "owner": "PLT-DATA", "role": "Database schema, migrations, and ORM layer" },
    "design-system": { "owner": "PLT-DESIGN", "role": "Meridian and Strata Workbench design system" },
    "desktop-app": { "owner": "PLT-CLIENTS", "role": "Desktop client application" },
    "developer-platform": { "owner": "PLT-DEV", "role": "Developer platform, CLI, and builder tooling" },
    "extension-api": { "owner": "PLT-DEV", "role": "Extension and plugin host contracts" },
    "extensions": { "owner": "PLT-DEV", "role": "Vertical extensions (Healthcare, Education, etc.)" },
    "framework": { "owner": "PLT-BIZ", "role": "Core application framework and saved views" },
    "idp": { "owner": "PLT-IDENTITY", "role": "Identity provider, OIDC, and SSO services" },
    "infra": { "owner": "PLT-OPS", "role": "Cloud infrastructure, Docker, and SRE operations" },
    "kernel": { "owner": "PLT-CORE", "role": "Kernel runtime and tenant governor" },
    "marketing-site": { "owner": "PLT-WEB", "role": "Corporate marketing and public site" },
    "marketplace": { "owner": "PLT-DEV", "role": "Extension marketplace and app store" },
    "provider-admin-os": { "owner": "PLT-OPS", "role": "Provider operator administration console" },
    "sandbox": { "owner": "PLT-DEV", "role": "Isolated execution sandbox for extensions" },
    "sdk": { "owner": "PLT-DEV", "role": "Client SDK for TypeScript, Python, Dart" },
    "service-kit": { "owner": "PLT-CORE", "role": "Service scaffolding and common microservice kit" },
    "shared": { "owner": "PLT-CORE", "role": "Converged shared utilities, numbering, and temporal" },
    "storybook": { "owner": "PLT-DESIGN", "role": "Interactive component storybook workshop" },
    "tenant-admin": { "owner": "PLT-OPS", "role": "Tenant administration console" },
    "tenant-apps": { "owner": "PLT-WEB", "role": "Tenant enterprise web applications" },
    "tenant-site-template": { "owner": "PLT-WEB", "role": "Corporate tenant site template" },
    "tenant-sites": { "owner": "PLT-WEB", "role": "Tenant corporate website runtime" },
    "unierp-contracts": { "owner": "PLT-CONTRACTS", "role": "Published API and event contracts" },
    "unierp-mobile": { "owner": "PLT-CLIENTS", "role": "Flutter native mobile applications" },
    "unierp-platform": { "owner": "PLT-GOV", "role": "Platform governance, ADRs, and catalog" },
    "unierp-workspace": { "owner": "PLT-GOV", "role": "Polyrepo orchestration, verification, and tooling" },
    "web-studio": { "owner": "PLT-DEV", "role": "Low-code application and page builder" }
  }
}
